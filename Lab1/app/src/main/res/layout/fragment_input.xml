<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/background_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Оберіть фігуру:"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_header"
            android:layout_marginBottom="12dp"/>

        <RadioGroup
            android:id="@+id/radioGroupShapes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:padding="8dp">

            <RadioButton
                android:id="@+id/radioSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="Квадрат"
                android:buttonTint="@color/primary_blue" />

            <RadioButton
                android:id="@+id/radioCircle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="Коло"
                android:buttonTint="@color/primary_blue" />

            <RadioButton
                android:id="@+id/radioTriangle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:text="Трикутник"
                android:buttonTint="@color/primary_blue" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Параметри обчислення:"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_header"
            android:layout_marginBottom="12dp"/>

        <CheckBox
            android:id="@+id/checkArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="Площа"
            android:buttonTint="@color/check_accent" />

        <CheckBox
            android:id="@+id/checkPerimeter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:text="Периметр"
            android:buttonTint="@color/check_accent"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/buttonOk"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="ОК"
            android:backgroundTint="@color/button_ok_bg"
            android:textColor="@color/white" />

    </LinearLayout>
</ScrollView>